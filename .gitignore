# Results directory: we track the measurement pkls (reproduction scripts
# load them) and the recheck JSON evidence, but ignore anything else that
# lands in there ad hoc — new large outputs from re-runs, temporary
# fixtures, etc.
/results/*
!/results/*.pkl
!/results/*.csv
!/results/recheck/
!/results/recheck/**



